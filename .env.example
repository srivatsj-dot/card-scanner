# Get a FREE key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: enable "Continue with Google" sign-in. Create a Web OAuth client at
# https://console.cloud.google.com/apis/credentials and paste the Client ID here
# (it ends in .apps.googleusercontent.com). Add your app's URL to the client's
# "Authorized JavaScript origins" (e.g. http://localhost:5173). Leave blank to
# use username/password sign-in only. NOTE: read at BUILD time by Vite.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: send welcome + password-reset emails. Leave all blank and the app
# still works — it just won't email. Tried in this order: SMTP, then Gmail,
# then Resend. To email ANYONE (any recipient) with NO domain, use Gmail or
# SMTP. Resend can only email your own address until you verify a domain.
#
# A) Gmail (free, no domain, sends to anyone): turn on 2-Step Verification on
#    your Google account, then create an App Password (Google Account >
#    Security > App passwords) and paste it below. Sends from your Gmail.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# B) Any SMTP provider (sends to anyone; no domain if the provider allows a
#    verified single sender — e.g. Brevo/Sendinblue 300/day free, SendGrid,
#    Mailgun, Outlook, or your own mail server).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true only for port 465
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-key
# SMTP_FROM=Card-O-Rama <you@example.com>
#
# C) Resend (only emails your own address UNTIL you verify a domain):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Card-O-Rama <hello@yourdomain.com>

# Optional: use REAL eBay prices instead of the model's estimate. Create a free
# developer app at https://developer.ebay.com (use the PRODUCTION keyset) and
# paste its App ID (Client ID) and Cert ID (Client Secret) below. When set,
# scans/searches price cards from current eBay listings.
# EBAY_CLIENT_ID=your-app-id
# EBAY_CLIENT_SECRET=your-cert-id

# Optional: real Pokémon TCG tournament results in the morning digest (winning
# decks, meta movers). Get a free key at https://play.limitlesstcg.com/account
# and paste it below. Without it, the Pokémon section uses the model + search.
# The other sports (baseball/basketball/football/soccer/hockey/cricket) need NO
# key — they use free public feeds (MLB/NHL official, ESPN, ESPNcricinfo).
# LIMITLESS_API_KEY=your-limitless-key

# Optional: override the model (defaults to gemini-2.5-flash — sharper at
# reading cards). If you keep hitting free-tier rate limits, the lighter model
# has higher limits but is less accurate:
# CARD_SCANNER_MODEL=gemini-2.5-flash-lite

# Optional: turn off live Google Search grounding (faster, but uses the model's
# training knowledge instead of current player form / prices).
# CARD_SCANNER_GROUNDING=false

# Port the API server listens on (defaults to 8787)
# PORT=8787
