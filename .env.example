# Get a FREE key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the model (defaults to gemini-2.5-flash).
# For higher free-tier rate limits, try the lighter model:
# CARD_SCANNER_MODEL=gemini-2.5-flash-lite

# Optional: turn off live Google Search grounding (faster, but uses the model's
# training knowledge instead of current player form / prices).
# CARD_SCANNER_GROUNDING=false

# Port the API server listens on (defaults to 8787)
# PORT=8787
