# Get a FREE key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: enable "Continue with Google" sign-in. Create a Web OAuth client at
# https://console.cloud.google.com/apis/credentials and paste the Client ID here
# (it ends in .apps.googleusercontent.com). Add your app's URL to the client's
# "Authorized JavaScript origins" (e.g. http://localhost:5173). Leave blank to
# use username/password sign-in only. NOTE: read at BUILD time by Vite.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: send welcome + password-reset emails. Leave all blank and the app
# still works — it just won't email. Tried in this order: Brevo, SMTP, Gmail,
# Outlook, Resend.
#
# IMPORTANT: many hosts (Render, Vercel, etc.) BLOCK outbound SMTP ports, so
# Gmail/Outlook/SMTP just hang and never deliver. If your test email "loads
# forever," that's this. Use BREVO below — it sends over HTTPS (port 443), so
# it works behind those blocks, emails ANYONE, free 300/day, no domain (just
# verify one sender address).
#
# A0) Brevo (RECOMMENDED on Render/Vercel; HTTPS, no SMTP port needed): sign up
#     at https://www.brevo.com, verify a sender email (Senders & IP > add a
#     sender — they email it a confirm link), then create an API key (SMTP &
#     API > API Keys). Set BREVO_FROM to that verified sender.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# BREVO_FROM=Card-O-Rama <you@gmail.com>
#
# A) Gmail (works ONLY if your host allows outbound SMTP): turn on 2-Step Verification on
#    your Google account, then create an App Password (Google Account >
#    Security > App passwords) and paste it below. Sends from your Gmail.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# A2) Outlook / Hotmail (free, no domain, sends to anyone): create an app
#     password (account.microsoft.com > Security > Advanced > App passwords;
#     requires 2-step verification) and paste it below.
# OUTLOOK_USER=you@outlook.com
# OUTLOOK_APP_PASSWORD=your-app-password
#
# B) Any SMTP provider (sends to anyone; no domain if the provider allows a
#    verified single sender — e.g. Brevo/Sendinblue 300/day free, SendGrid,
#    Mailgun, Outlook, or your own mail server).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true only for port 465
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-key
# SMTP_FROM=Card-O-Rama <you@example.com>
#
# C) Resend (only emails your own address UNTIL you verify a domain):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Card-O-Rama <hello@yourdomain.com>

# Optional: use REAL eBay prices instead of the model's estimate. Create a free
# developer app at https://developer.ebay.com (use the PRODUCTION keyset) and
# paste its App ID (Client ID) and Cert ID (Client Secret) below. When set,
# scans/searches price cards from current eBay listings.
# EBAY_CLIENT_ID=your-app-id
# EBAY_CLIENT_SECRET=your-cert-id

# Optional: boost photo identification with Google reverse-image search (Cloud
# Vision "Web Detection"). Create a Google Cloud project, enable the Vision API,
# and make an API key. There's a free tier (~1,000 images/month) but the project
# needs billing enabled. This is a CLOUD key, not the AI Studio GEMINI_API_KEY.
# GOOGLE_VISION_API_KEY=your-google-cloud-vision-key

# Pokémon card prices come from pokemontcg.io (free TCGplayer/Cardmarket market
# data) automatically — NO key needed. Optionally set a free key from
# https://pokemontcg.io to raise the rate limit.
# POKEMONTCGIO_API_KEY=your-pokemontcg-key

# Optional: real Pokémon TCG tournament results in the morning digest (winning
# decks, meta movers). Get a free key at https://play.limitlesstcg.com/account
# and paste it below. Without it, the Pokémon section uses the model + search.
# The other sports (baseball/basketball/football/soccer/hockey/cricket) need NO
# key — they use free public feeds (MLB/NHL official, ESPN, ESPNcricinfo).
# LIMITLESS_API_KEY=your-limitless-key

# Optional: monetize with Google AdSense (shows other companies' ads inside the
# app; Google pays you). Apply at https://adsense.google.com with your live site,
# get approved, then create an ad unit and paste your publisher id + slot id.
# Blank = no ads load at all (dev and pre-approval stay ad-free). Read at BUILD
# time by Vite. Note: AdSense needs a live, reviewed site — it won't show on
# localhost, and approval requires real content + a privacy policy.
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=0000000000

# Optional: measure your OWN ad campaigns (Search/YouTube) — which ads create
# real sign-ups. Set a GA4 ("G-XXXX") or Google Ads ("AW-XXXX") tag id; the
# second var fires a sign-up conversion. Blank = no tracking. BUILD-time (Vite).
# VITE_GTAG_ID=G-XXXXXXXXXX
# VITE_ADS_CONVERSION=AW-XXXXXXXXX/abcdEFGHijkl

# Optional: override the model (defaults to gemini-2.5-flash — sharper at
# reading cards). If you keep hitting free-tier rate limits, the lighter model
# has higher limits but is less accurate:
# CARD_SCANNER_MODEL=gemini-2.5-flash-lite

# Optional: turn off live Google Search grounding (faster, but uses the model's
# training knowledge instead of current player form / prices).
# CARD_SCANNER_GROUNDING=false

# Port the API server listens on (defaults to 8787)
# PORT=8787
